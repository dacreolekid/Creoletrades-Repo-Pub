/*
  # ── Security ──
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://www.youtube.com; connect-src 'self' https://www.googleapis.com https://formspree.io https://www.youtube.com https://cloudflareinsights.com; upgrade-insecure-requests;
  Cross-Origin-Opener-Policy: same-origin-allow-popups

  # ── Performance ──
  # Always revalidate by default. Pretty URLs (/, /join, /results, /blog, /academy)
  # do NOT match the /*.html rule below, so they land here. A long max-age here
  # keeps a deploy invisible to returning visitors until it expires.
  # Big, content-stable assets get explicit long caches further down.
  Cache-Control: public, max-age=0, must-revalidate

# ── HTML — never cache, always fresh ──
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# ── Images — cache for 1 year (they won't change often) ──
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable

# ── Fonts — cache for 1 year ──
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable

# ── CSS / JS — always revalidate ──
# No build step, so filenames are not content-hashed: ct.css and ct-*.js keep the
# same URL forever. A long max-age would pin returning visitors to stale styles or
# a stale purchase gate for that whole window. Revalidation returns a ~200 byte 304
# when nothing changed, which is cheap for files this size.
/*.css
  Cache-Control: public, max-age=0, must-revalidate
/*.js
  Cache-Control: public, max-age=0, must-revalidate

# ── PDF — cache for 1 year (the starter guide download) ──
/*.pdf
  Cache-Control: public, max-age=31536000, immutable


# ── 404 page — never cache ──
/404.html
  Cache-Control: no-cache, no-store, must-revalidate
